# Laravel application base URL, without /api/printing.
LARAVEL_URL=https://orders.example.com
PRINT_WORKER_TOKEN=
PRINT_POLL_SECONDS=3
PRINT_WORKER_DB=/var/lib/kitchen-print-worker/worker.sqlite
PRINT_PAYLOAD_RETENTION_DAYS=30

# Development only: stdout consumes jobs and marks them locally completed.
PRINTER_BACKEND=stdout

# escpos-tcp uses a literal IP:port; escpos-usb uses Linux usblp.
# PRINTER_ADDRESS=192.168.1.50:9100
# PRINTER_DEVICE=/dev/usb/lp0
PRINTER_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
PRINTER_WIDTH_DOTS=576
PRINTER_FONT_PX=28
PRINTER_CUT=false
