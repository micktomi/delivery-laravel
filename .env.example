APP_NAME="Delivery Menu"
APP_ENV=local
APP_TIMEZONE=Europe/Athens
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coffee_delivery
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma separated proxy IPs (nginx / Cloudflare). Empty = localhost only.
TRUSTED_PROXIES=

# Viva.com Smart Checkout remains unavailable until explicitly enabled.
VIVA_ENABLED=false
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
VIVA_ENVIRONMENT=demo
VIVA_WEBHOOK_VERIFICATION_KEY=
# Optional. Set the same pair on the webhook in the Viva dashboard to stop the
# endpoint accepting anonymous posts. Both blank leaves it open; filling in
# only one is treated as a broken deployment and the webhook fails closed.
VIVA_WEBHOOK_USERNAME=
VIVA_WEBHOOK_PASSWORD=

# Used once by DatabaseSeeder to create the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Smallest cart subtotal an order is allowed to place with.
MINIMUM_ORDER_AMOUNT=5.00
