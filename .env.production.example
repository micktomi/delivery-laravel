# Template for the live shop. Copy to .env on the server, fill in, then:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache route:cache view:cache
# See DEPLOYMENT.md for the full checklist.
#
# ---------------------------------------------------------------------------
# The production database holds real orders and real catalogue data. We never
# run `db:seed` against it. New products and categories are added from Filament,
# or with a separate, production-safe data migration.
#
# `db:seed` duplicates every option group, resets prices the owner edited,
# deletes the legacy catalogue rows, and overwrites the admin password whenever
# ADMIN_PASSWORD is still set below. It belongs to a brand new install with an
# empty database and nowhere else — see "First install" in DEPLOYMENT.md.
#
# Never on this server: db:seed, migrate:fresh, migrate:refresh, migrate:reset,
# db:wipe, composer setup. The only migration command is `migrate --force`.
# ---------------------------------------------------------------------------

APP_NAME="Delivery Menu"
APP_ENV=production
APP_TIMEZONE=Europe/Athens
APP_KEY=
APP_DEBUG=false
# Every /storage/... product image URL is built from this: config/filesystems.php
# derives the public disk's url from APP_URL. Exact live scheme and host, no
# trailing slash. Run `php artisan config:cache` after changing it.
APP_URL=https://example.gr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. The cart and the staff login both ride on this cookie.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Only sets the default disk for bare Storage:: calls. The product image
# pipeline pins the `public` disk explicitly at every call site — upload,
# encode, delete and URL generation — so this value does not decide where
# photos are stored or how they are served. See DEPLOYMENT.md.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.gr"
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated proxy IPs (nginx / Cloudflare). Empty = localhost only.
TRUSTED_PROXIES=127.0.0.1

# Optional HTTP Basic credentials for the Viva webhook. Set the same pair on
# the webhook in the Viva dashboard and anonymous posts are refused before any
# outbound call. Both blank leaves the endpoint open; filling in only one is
# treated as a broken deployment and the webhook fails closed.
VIVA_WEBHOOK_USERNAME=
VIVA_WEBHOOK_PASSWORD=

# Read by DatabaseSeeder to create the admin account on a brand new install.
# There is no default password. Remove ADMIN_PASSWORD as soon as the first
# install is done: while it is set, any seeder run overwrites the password of
# the existing admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
