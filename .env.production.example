# Template for the live shop. Copy to .env on the server, fill in, then:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan db:seed --force        (first deploy only, creates the admin)
#   php artisan config:cache route:cache view:cache
# See DEPLOYMENT.md for the full checklist.

APP_NAME="Delivery Menu"
APP_ENV=production
APP_TIMEZONE=Europe/Athens
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.gr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. The cart and the staff login both ride on this cookie.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.gr"
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated proxy IPs (nginx / Cloudflare). Empty = localhost only.
TRUSTED_PROXIES=127.0.0.1

# Read once by DatabaseSeeder to create the admin account. Remove after the
# first deploy; there is no default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
